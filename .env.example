# Leave DATABASE_URL empty to run on the embedded demo database (in memory; data resets on restart).
# Set it to any Postgres 14+ connection string (for example a Supabase project) for persistent data.
DATABASE_URL=

# Seeds the Greenfield demo group and platform staff on the first boot of an EMPTY database. Leave unset for a real deployment.
SEED_DEMO=

# Long random string. Salts stored API-key hashes; changing it invalidates existing keys.
APP_SECRET=

# Public base URL, used in links sent to parents (application and payment links).
APP_URL=http://localhost:3000

# Bearer token a scheduler must send to GET /api/cron (run it every minute).
CRON_SECRET=

# Set to 1 only for demos: enables the simulated checkout and simulated parent replies on a real database.
DEMO_PAYMENTS=
