# Leave DATABASE_URL empty to run on the embedded demo database (data resets on restart).
# Set it to any Postgres 14+ connection string (for example Supabase) for persistent data.
DATABASE_URL=
# Required in production: long random string used to sign nothing by itself but to salt API key hashes.
APP_SECRET=change-me
# Set to 1 to seed the demo school group on first boot of an empty database.
SEED_DEMO=1
DEMO_PAYMENTS=
